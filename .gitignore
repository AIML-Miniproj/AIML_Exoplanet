# Virtual environment
venv/
env/

# Downloaded / generated data (re-creatable). data/examples/ is committed.
data/*
!data/examples/

# Trained model: only the files the app and tests need are committed
# (re-create with scripts/train_triage.py and scripts/save_evaluation.py).
models/*
!models/triage_xgb.json
!models/triage_meta.json
!models/model_evaluation.json

# Output plots (regenerate on run)
outputs/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Jupyter checkpoints
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Streamlit secrets (config.toml is committed)
.streamlit/secrets.toml

# Test / lint caches
.pytest_cache/
.ruff_cache/
